@Book{Siek2023,
  author={Jeremy G. Siek},
  title={Essentials of Compilation: An Incremental Approach in Racket},
  year={2023},
  month=feb,
  publisher={The MIT Press},
  address={Cambridge, Massachusetts},
  isbn={978-0-262-04776-0},
  url={https://github.com/IUCompilerCourse/Essentials-of-Compilation},
  note={
    Presents compiler construction as a sequence of small language extensions
    and compiler transformations, so that each new source-language feature
    motivates a corresponding implementation technique.
    Particularly relevant for its executable, incremental presentation of
    language semantics and transformations, using Racket and a nanopass-style
    organization rather than treating compilation as a sequence of large,
    monolithic phases.
  }
}

