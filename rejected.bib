@Misc{Dennis1975,
  author="Dennis, Jack B.",
  editor="Bauer, F. L.
  and Dennis, J. B.
  and Waite, W. M.
  and Gotlieb, C. C.
  and Graham, R. M.
  and Griffiths, M.
  and Helms, H. J.
