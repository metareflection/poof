@WebPage{Haufe2025,
  author={Michael L. Haufe},
  title={Comb Inheritance},
  year={2025},
  month=dec,
  organization={The New Objective},
  url={https://thenewobjective.com/types-and-programming-languages/comb-inheritance/},
  lastchecked={2026-09-06},
  note={Explains comb inheritance, a NewtonScript technique that combines a
    prototype-inheritance chain with a separate parent-instance delegation
    chain.
    Reimplements the mechanism in JavaScript using proxies and illustrates its
    use for chain-of-responsibility, document hierarchies and event propagation.
    Relevant as a modern explanation of an unusual multiple-inheritance lookup
    strategy in which type inheritance and contextual delegation coexist as
    distinct dimensions.}
}

