%% 2026

@Article{Kidney2026,
  author={Donnacha Oisín Kidney and Nicolas Wu},
  title={Hyperfunctions: Communicating Continuations},
  journal={Proceedings of the ACM on Programming Languages},
  year={2026},
  month={jan},
  volume={10},
  number={POPL},
  pages={174--203},
  eid={7},
  numpages={30},
  publisher={Association for Computing Machinery},
  issn={2475-1421},
  doi={10.1145/3776649},
  url={https://doisinkidney.com/pdfs/hyperfunctions.pdf},
  note={
    Develops hyperfunctions, continuation-like objects that allow continuations
    to communicate with one another and thereby support concurrent interaction.
    Identifies the same underlying construction in earlier work on algebraic
    effects, coroutines and breadth-first traversal, where it had often been
    rediscovered without being recognized as a hyperfunction.
    Particularly relevant for clarifying a nontrivial continuation abstraction
    and for showing how it yields both a fully abstract continuation semantics
    for CCS and efficient first-class coroutines.
  }
}


