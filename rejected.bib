@Article{Crichton2024,
  author={Will Crichton and Shriram Krishnamurthi},
  title={A Core Calculus for Documents: Or, Lambda: The Ultimate Document},
  journal={Proceedings of the ACM on Programming Languages},
  year={2024},
  month=jan,
  volume={8},
  number={POPL},
  pages={667--694},
  eid={23},
  numpages={28},
  publisher={Association for Computing Machinery},
  issn={2475-1421},
  doi={10.1145/3632865},
  url={https://cs.brown.edu/people/sk/Publications/Papers/Published/ck-core-calc-doc-lambda-ultimate-doc/paper.pdf},
  note={Develops a formal calculus for document languages, classifying them by
