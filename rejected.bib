  author={Oleg Kiselyov and Hiromi Ishii},
  title={Freer Monads, More Extensible Effects},
  booktitle={Proceedings of the 2015 ACM SIGPLAN Symposium on Haskell},
  editor={Ben Lippmeier},
  year={2015},
  month={aug},
  pages={94--105},
  location={Vancouver, British Columbia, Canada},
  publisher={Association for Computing Machinery},
  address={New York, NY, USA},
  isbn={978-1-4503-3808-0},
  doi={10.1145/2804302.2804319},
  url={https://okmij.org/ftp/Haskell/extensible/more.pdf},
  note={
    Derives freer monads and extensible effects by progressively abstracting
    the representation of effectful computations, separating effect requests
    from their continuations and combining effects through open unions.
    Particularly relevant for its modular addition, composition and
    elimination of effects, and for showing how exposing continuations yields
    both a simpler formulation and an asymptotically more efficient
    implementation.
  }
}

