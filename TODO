  note={Argues that concerns are multi-dimensional and that available formalisms constrain decomposition; directly relevant to why single inheritance forces clumping.}
}

@inproceedings{Harrison1993SubjectOriented,
  author={William Harrison and Harold Ossher},
  title={Subject-Oriented Programming: A Critique of Pure Objects},
  booktitle={Proceedings of the Eighth Annual Conference on Object-Oriented Programming Systems, Languages, and Applications},
  pages={411--428},
  year={1993},
  doi={10.1145/167962.165932},
  url={https://doi.org/10.1145/167962.165932},
  note={Early attack on the idea that one class hierarchy can capture all views of an object; relevant to the context-multiplicity failure of single inheritance.}
}

