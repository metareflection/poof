@WebPage{Krishnamurthi2024,
  author={Shriram Krishnamurthi},
  title={Bicameral, Not Homoiconic},
  year={2024},
  organization={Parenthetically Speaking},
  url={https://parentheticallyspeaking.org/articles/bicameral-not-homoiconic/},
  lastchecked={2026-09-06},
  note={Argues that ``homoiconicity'' is too vague to explain what is distinctive
    about Lisp syntax, and proposes ``bicameral syntax'' instead: a reader first
    constructs a well-formed tree, after which a parser checks language-specific
    validity.
    Particularly relevant for distinguishing reader-level tree structure from
    abstract syntax, and for explaining why Lisp-family macro systems benefit
    from a structured intermediate representation without requiring literal
    code-as-data identity.}
}

