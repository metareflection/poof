@InCollection{Stein1989,
  author={Lynn Andrea Stein and Henry Lieberman and David Ungar},
  title={A Shared View of Sharing: The Treaty of Orlando},
  booktitle={Object-Oriented Concepts, Databases, and Applications},
  editor={Won Kim and Frederick H. Lochovsky},
  year={1989},
  chapter={3},
  pages={31--48},
  publisher={ACM Press and Addison-Wesley},
  address={Reading, MA, USA},
  isbn={0-201-14410-7},
  doi={10.1145/63320.66470},
  note={
    An expanded presentation and commentary on the 1987 Treaty of Orlando,
    which sought to reconcile class-based inheritance and prototype-based delegation.
    Stein, Lieberman and Ungar decompose the apparent opposition into
    independent dimensions of sharing, distinguishing mechanisms for creating
    similar objects from mechanisms by which one object can act on behalf of another.
    The original two-page treaty appeared in the OOPSLA 1987 Addendum.

    The paper brings interesting concepts such as three dimensions for sharing software:
    static vs dynamic, implicit vs explicit (ability to share), per object vs per group.
    Stein then discusses anticipated vs unanticipated sharing, and tries to organize
    a taxonomy of techniques and situations when one technique is preferable to the other,
    rather than explain how the techniques are semantically related to each other.
    A feeling / perception approach that maybe defuses conflict but doesn’t solve any problem.
  }
}

