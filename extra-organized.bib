@Article{Ord2023,
  author={Toby Ord},
  title={The Lindy Effect},
  journal={arXiv},
  year={2023},
  eprint={2308.09045},
  doi={10.48550/arXiv.2308.09045},
  url={https://arxiv.org/pdf/2308.09045},
  note={
    Gives a clean modern statement and analysis of the Lindy effect:
    things with longer pasts tend, in appropriate domains, to have longer
    futures.
    Relevant as a rationale for preferring a long-lived exposition language
    such as Scheme, whose decades of continued use provide evidence of
    continued longevity.
  }
}

@WebPage{Rochus2023,
  author={Rochus},
  title={Ask HN: Which CS Publication Used Term “Object-Oriented” for the First Time?},
  year={2023},
  month=jul,
  organization={Hacker News},
  url={https://news.ycombinator.com/item?id=36826762},
  lastchecked={2026-09-06},
  note={
    Collaborative bibliographical investigation into the earliest documented
    uses of the term ``object-oriented'' in computer science.
    The discussion identifies uses predating Smalltalk, including Robert
    Bobrow's 1971 database discussion, and concludes that Jones and Liskov's
    1976 CLU report is the earliest located application of ``object-oriented''
    specifically to a programming language.
    Particularly useful for separating the history of the term from the
    history of the programming concepts later associated with it.
  }
}

@Book{Siek2023,
  author={Jeremy G. Siek},
  title={Essentials of Compilation: An Incremental Approach in Racket},
  year={2023},
  month=feb,
  publisher={The MIT Press},
  address={Cambridge, Massachusetts},
  isbn={978-0-262-04776-0},
  url={https://github.com/IUCompilerCourse/Essentials-of-Compilation},
  note={
    Presents compiler construction as a sequence of small language extensions
    and compiler transformations, so that each new source-language feature
    motivates a corresponding implementation technique.
    Particularly relevant for its executable, incremental presentation of
    language semantics and transformations, using Racket and a nanopass-style
    organization rather than treating compilation as a sequence of large,
    monolithic phases.
  }
}

