%% Deferred bibliography and unresolved literature leads from extra.bib.
%%
%% These works were not included in extra-organized.bib because they were
%% tangential, secondary, version-sensitive, or superseded by an earlier
%% priority source. They are preserved here for possible use in other
%% bibliographies. Dated entries are sorted by year and citation key;
%% undated web documentation follows at the end.

@book{Smullyan1985,
  author={Smullyan, Raymond M.},
  title={To Mock a Mockingbird and Other Logic Puzzles: Including an Amazing Adventure in Combinatory Logic},
  publisher={Alfred A. Knopf},
  year={1985},
  note={An entertaining exposition of combinatory logic, including self-application and fixed-point combinators; potentially useful for a separate bibliography on recursion or combinators, but only metaphorically related to object orientation.}
}

@article{MitchellPlotkin1988,
  author={Mitchell, John C. and Plotkin, Gordon D.},
  title={Abstract Types Have Existential Type},
  journal={ACM Transactions on Programming Languages and Systems},
  volume={10},
  number={3},
  pages={470–502},
  year={1988},
  doi={10.1145/44501.45065},
  url={https://doi.org/10.1145/44501.45065},
  note={Expanded journal version of the 1985 POPL paper retained in the main bibliography; useful when the fuller treatment matters more than establishing priority.}
}

@misc{Kay1998SqueakMail,
  author={Kay, Alan},
  title={Email to the Squeak Developers Mailing List, 10 October 1998},
  year={1998},
  url={https://medium.com/javascript-scene/the-forgotten-history-of-oop-88d71b9b2d9f},
  note={A frequently quoted statement about messaging and object orientation. The supplied URL is a secondary article rather than a stable primary archive of the message, so the entry was deferred pending identification of the original post.}
}

@inproceedings{CurienHerbelin2000,
  author={Curien, Pierre-Louis and Herbelin, Hugo},
  title={The Duality of Computation},
  booktitle={Proceedings of the Fifth ACM SIGPLAN International Conference on Functional Programming},
  series={ICFP ’00},
  pages={233–243},
  publisher={Association for Computing Machinery},
  year={2000},
  doi={10.1145/351240.351262},
  url={https://doi.org/10.1145/351240.351262},
  note={Foundational work on the call-by-name/call-by-value duality and the λμ~μ calculus; worthwhile for a bibliography on control duality, but too remote from the main object-orientation argument.}
}

@techreport{JamesSabry2012,
  author={James, Roshan P. and Sabry, Amr},
  title={The Two Dualities of Computation: Negative and Fractional Types},
  institution={Indiana University},
  year={2012},
  url={https://web.archive.org/web/20121229014345/https://www.cs.indiana.edu/~sabry/papers/rational.pdf},
  note={Unpublished technical report on negative and fractional types; potentially useful for a bibliography on reversible computation or type dualities, but not central to object orientation.}
}

@inproceedings{VermaEtAl2015,
  author={Verma, Abhishek and Pedrosa, Luis and Korupolu, Madhukar R. and Oppenheimer, David and Tune, Eric and Wilkes, John},
  title={Large-Scale Cluster Management at Google with Borg},
  booktitle={Proceedings of the Tenth European Conference on Computer Systems},
  series={EuroSys ’15},
  pages={18:1–18:17},
  publisher={Association for Computing Machinery},
  year={2015},
  doi={10.1145/2741948.2741964},
  url={https://doi.org/10.1145/2741948.2741964},
  note={Useful production context for Google’s declarative configuration lineage, including BCL/GCL, but the paper is primarily about cluster management rather than object systems.}
}

@misc{Wayne2019Kay,
  author={Wayne, Hillel},
  title={Alan Kay Did Not Invent Objects},
  year={2019},
  url={https://hillelwayne.com/post/alan-kay/},
  note={Accessible secondary historical commentary emphasizing Simula’s priority for objects, classes and messages; deferred because the main bibliography favors primary historical sources.}
}

@misc{Nixcademy2024Overlays,
  author={{Nixcademy}},
  title={Mastering Nixpkgs Overlays: Techniques and Best Practice},
  year={2024},
  url={https://nixcademy.com/posts/mastering-nixpkgs-overlays-techniques-and-best-practice/},
  note={Practitioner-oriented discussion of Nixpkgs overlays and their final/prev discipline; useful implementation evidence, but secondary and version-sensitive.}
}

@misc{GoFAQOOP,
  author={{The Go Project}},
  title={Frequently Asked Questions: Is Go an Object-Oriented Language?},
  url={https://go.dev/doc/faq#Is_Go_an_object-oriented_language},
  note={First-party but continuously updated language documentation giving Go’s “yes and no” answer; useful near a claim about Go, but unsuitable as a stable historical source.}
}

@misc{NixOSWikiOverlays,
  author={{NixOS Wiki contributors}},
  title={Overlays},
  url={https://wiki.nixos.org/wiki/Overlays},
  note={Community documentation describing overlays in subclassing terms and recording the self/super to final/prev terminology; useful near an implementation claim, but unstable as general bibliography evidence.}
}

@misc{RustBookOOP,
  author={Klabnik, Steve and Nichols, Carol and the Rust Community},
  title={The Rust Programming Language: What Does Object-Oriented Mean?},
  url={https://doc.rust-lang.org/book/ch18-01-what-is-oo.html},
  note={First-party but continuously revised discussion of which object-oriented features Rust supports; best cited at the exact claim rather than treated as a stable historical source.}
}

